  "modified_code": "function forwardCookie(res, response, alterPath) {\n    // node-fetch v2: headers.getAll() removed. Use headers.raw()['set-cookie'] to obtain an array of Set-Cookie values safely.\n    var cookies = (response.headers.raw && response.headers.raw()['set-cookie']) || [];\n    if (cookies.length) {\n        cookies = cookies.map(function (cstr) {\n            cstr = cstr.replace(/; *Domain=[^;]*(; *)?/i, '; ');\n            if (alterPath === false) {\n                return cstr;\n            } else if ('function' == typeof alterPath) {\n                return cstr.replace(/; *Path=(\\/[^;]*)(; *)?/i, function (all, $1, $2) {\n                    return '; Path=' + alterPath($1) + ($2 || '');\n                });\n            } else {\n                return cstr.replace(/; *Path=\\/[^;]*(; *)?/i, '; Path=/$1');\n            }\n        });\n        var prev = res.get('Set-Cookie');\n        if (prev) {\n            if (Array.isArray(prev)) {\n                cookies = prev.concat(cookies);\n            } else {\n                cookies = [prev].concat(cookies);\n            }\n        }\n        res.set('Set-Cookie', cookies);\n    }\n}",
  "additional_req": "",
  "dependencies": [
    "node-fetch@^2.0.0"
  ]
}
