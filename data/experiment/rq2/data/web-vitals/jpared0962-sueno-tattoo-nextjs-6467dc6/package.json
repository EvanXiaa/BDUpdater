{
  "name": "sueno-tattoo-react",
  "version": "1.0.5",
  "type": "module",
  "description": "Modern React website for Sueno Tattoo - Professional tattoo artistry in Laurel, MD with authentication",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node generate-seo-pages.js && npm run copy-test-files",
    "copy-test-files": "cp ai-seo-features-test.html schema-validation-test.html privacy-consent-test.html admin-dashboard.html real-time-location-test.html enhanced-location-test.html integrated-services-test.html dist/ 2>/dev/null || true",
    "prestart": "npm run build",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:components": "vitest run src/components",
    "test:services": "vitest run src/services",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:serve": "npx http-server ./docs -p 3001",
    "bundle-analyze": "npx vite-bundle-analyzer dist",
    "perf:monitor": "node scripts/performance-monitor.js",
    "upload-images": "node upload-images.js",
    "predeploy": "npm run upload-images",
    "deploy": "railway up",
    "fix:styled-motion": "node remove-styled-motion.js",
    "analyze": "node performance-optimization.js",
    "monitor": "node monitor-website.js",
    "deploy:ai": "bash deploy-ai-website.sh",
    "health": "npm run analyze && npm run monitor && npm run test:coverage"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@supabase/supabase-js": "^2.50.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.0",
    "cloudinary": "^2.7.0",
    "cloudinary-core": "^2.13.0",
    "cloudinary-react": "^1.8.1",
    "commander": "^14.0.0",
    "compression": "^1.7.4",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "framer-motion": "^11.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "lucide-react": "^0.525.0",
    "node-cache": "^5.1.2",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.0",
    "react-helmet-async": "^1.3.0",
    "react-intersection-observer": "^9.4.2",
    "react-lazy-load-image-component": "^1.5.6",
    "react-router-dom": "^6.8.1",
    "styled-components": "^6.0.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/styled-components": "^5.1.26",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^8.35.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "glob": "^7.2.3",
    "happy-dom": "^15.11.6",
    "jsdoc": "^4.0.4",
    "jsdoc-to-markdown": "^9.0.2",
    "jsdom": "^26.1.0",
    "puppeteer": "^24.12.1",
    "vite": "^5.0.0",
    "vite-bundle-analyzer": "^0.18.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "tattoo",
    "react",
    "responsive",
    "mobile-first",
    "artist",
    "portfolio"
  ],
  "author": "Jose Alvarado - Sueno Tattoo",
  "license": "MIT"
}
