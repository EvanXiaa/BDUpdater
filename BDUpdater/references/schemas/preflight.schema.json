{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dep_bc_repair_preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "handoff",
    "handoff_sha256",
    "package_name",
    "old_dependency_spec",
    "dependency_section",
    "new_version",
    "target_client_dir",
    "package_manager",
    "lockfile_policy",
    "lockfiles",
    "lockfile_sha256",
    "validation_commands",
    "supplemental_required",
    "supplemental_bc_ids"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "status": { "const": "passed" },
    "handoff": { "type": "string", "minLength": 1 },
    "handoff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "package_name": { "type": "string", "minLength": 1 },
    "old_dependency_spec": { "type": "string", "minLength": 1 },
    "dependency_section": {
      "enum": [
        "dependencies",
        "devDependencies",
        "optionalDependencies",
        "peerDependencies"
      ]
    },
    "new_version": { "type": "string", "minLength": 1 },
    "target_client_dir": { "type": "string", "minLength": 1 },
    "package_manager": { "type": "string", "minLength": 1 },
    "lockfile_policy": { "enum": ["update", "preserve", "none"] },
    "lockfiles": { "type": "array", "items": { "type": "string" } },
    "lockfile_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supplemental_required": { "type": "boolean" },
    "supplemental_bc_ids": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
